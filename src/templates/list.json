{# This template generates a json containing a file list, with file names and the name of the template to apply #}
{
    "global":[
        { "template": "pkg.vhd", "path" : "src", "filename": "{{pkg_name}}.vhd"},
        { "template": "top_level.vhd", "path" : "src", "filename": "{{top_name}}.vhd"},
        { "template": "core.vhd", "path" : "src", "filename": "{{core_name}}.vhd"}
    ],
    "interfaces": [
{# Here we return a list of lists. Each entry corresponds to one interface in the project, and contains a file list in the same format than the global list #}
{%- for interface in interfaces %}        [
  {%- if interface.interface_type == "SBI" %}
            { "template": "pif-sbi.vhd", "path" : "src", "filename": "{{interface.pif_name}}.vhd"}
  {%- else %}
        {{ throw(message="unsupported interface type ") }}
  {%- endif %}
        ]    
  {%- if not loop.last -%},
  {%- endif -%}
{%- endfor %}
    ]
}
